rules_version = '2';
// Idle Heartwood playtest rules.
// - Each player's save lives at users/{uid}/data/... and only that signed-in player can read or write it.
// - The ladder is readable by signed-in players; a player can only write their own row, with sane values.
// - Rate limits: anything a player can create (feedback, reward requests, ladder rows) is throttled per account
//   by the server clock, so a script can't loop requests to flood the game, the GitHub issues or the Firebase bill.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/clubStaff/$(request.auth.uid)); }
    // ---------- rate limits ----------
    // limits/{uid} holds, per throttled action, the server time of the player's last one (t) and that
    // action's document id (idf). A throttled create must update its pair in the same batch: the time must be
    // now and the previous one at least `secs` ago, and the id must match the new document, so a batch can't
    // sneak in more than one.
    function lim(uid) { return /databases/$(database)/documents/limits/$(uid); }
    function stepped(t, idf, secs) {
      let o = resource == null ? {} : resource.data;
      let x = request.resource.data;
      return (x.get(t, null) == o.get(t, null) && x.get(idf, null) == o.get(idf, null))
        || (x.get(t, null) == request.time
            && x.get(idf, null) is string && x.get(idf, '').size() <= 40
            && (o.get(t, null) == null || o.get(t, null) < request.time - duration.value(secs, 's')));
    }
    function throttled(t, idf, id) {
      let after = getAfter(lim(request.auth.uid)).data;
      return after.get(t, null) == request.time && after.get(idf, null) == id;
    }
    match /limits/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fb','fbid','rq','rqid'])
        && stepped('fb', 'fbid', 60)     // one bug report or idea a minute
        && stepped('rq', 'rqid', 20);    // one reward-claim code every 20 seconds
      allow list, delete: if false;
    }
    match /users/{uid}/data/{name} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && name != 'save3';
    }
    // The idle save only moves forward one step at a time: every write must set rev to exactly the stored rev + 1.
    // Two devices that both read rev N can't both write N+1 (race condition): the second is refused, and its next
    // sync re-reads the newer save instead of overwriting it.
    match /users/{uid}/data/save3 {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.rev is int;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.rev == resource.data.get('rev', 0) + 1;
    }
    match /ladder/{uid} {
      allow read: if signedIn();
      // st is the server time of the write: one ladder update per player every 5 seconds.
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['r','best','w','l','d','n','f','t','name','st'])
        && request.resource.data.st == request.time
        && (resource == null || resource.data.get('st', null) == null
            || resource.data.st < request.time - duration.value(5, 's'))
        && request.resource.data.r is int && request.resource.data.r >= 100 && request.resource.data.r <= 4000
        && request.resource.data.best is int && request.resource.data.best <= 4000
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        // every field other players see gets a type and a range, so a row can't carry markup or junk
        && request.resource.data.w is int && request.resource.data.w >= 0 && request.resource.data.w <= 1000000
        && request.resource.data.l is int && request.resource.data.l >= 0 && request.resource.data.l <= 1000000
        && request.resource.data.d is int && request.resource.data.d >= 0 && request.resource.data.d <= 1000000
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 3000000
        && request.resource.data.f is string && request.resource.data.f.size() <= 8
        && request.resource.data.t is number;
    }
    // Bug reports and ideas: players can send, nobody can read back from the game.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['type','text','ctx','t','uid','status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['bug','idea']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1500
        && request.resource.data.ctx is map
        && request.resource.data.status == 'new'
        && throttled('fb', 'fbid', id);
      allow read, update, delete: if false;
    }
    // Community polls: one vote per signed-in player, final once cast; votes are countable by everyone.
    match /polls/{poll}/votes/{uid} {
      allow read: if signedIn();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['o','t'])
        && request.resource.data.o is int && request.resource.data.o >= 0 && request.resource.data.o < 10;
      allow update, delete: if false;
    }
    // ---------- UrgerBae Card Club ----------
    // Nothing secret lives in the page: staff are Google accounts listed in clubStaff (added by hand in the
    // Firebase console), today's counter code is stored here where only staff can read it, and rewards are
    // recorded by a staff device after it checks the customer's verified visits.
    // Staff can read a customer's club binder to check a reward.
    match /users/{uid}/data/club {
      allow read: if isStaff();
    }
    // clubStaff/{uid}: one empty doc per staff Google account. Console only.
    match /clubStaff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    // clubDaily/{YYYY-MM-DD}: today's random counter code and when it stops working.
    match /clubDaily/{day} {
      allow get: if isStaff();
      allow create, update: if isStaff()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['k','exp','by'])
        && request.resource.data.k is string && request.resource.data.k.size() >= 8 && request.resource.data.k.size() <= 32
        && request.resource.data.exp is timestamp
        && request.resource.data.by == request.auth.uid;
      allow list, delete: if false;
    }
    // clubScans/{uid}_{day}: one verified counter visit per account per day. Only creatable with the live code.
    match /clubScans/{id} {
      allow get: if signedIn() && (id.split('_')[0] == request.auth.uid || isStaff());
      allow list: if isStaff();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','day','k','t'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.auth.uid + '_' + request.resource.data.day
        && request.resource.data.t == request.time
        && exists(/databases/$(database)/documents/clubDaily/$(request.resource.data.day))
        && get(/databases/$(database)/documents/clubDaily/$(request.resource.data.day)).data.k == request.resource.data.k
        && request.time < get(/databases/$(database)/documents/clubDaily/$(request.resource.data.day)).data.exp;
      allow update, delete: if false;
    }
    // clubReq/{CODE}: a customer asks to claim a reward; staff type the 6-character code at the counter.
    match /clubReq/{code} {
      allow get: if signedIn() && (isStaff() || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid','mid','t'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mid is string && request.resource.data.mid.matches('^[a-z]{1,16}$')  // a reward id, never a path or markup
        && request.resource.data.t == request.time
        && throttled('rq', 'rqid', code);
      allow list, update, delete: if false;
    }
    // clubClaims/{uid}_{milestone}: written once by a staff device when a reward is handed over. Never removable.
    match /clubClaims/{id} {
      allow get: if signedIn() && (id.split('_')[0] == request.auth.uid || isStaff());
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['uid','mid','by','t','note'])
        && id == request.resource.data.uid + '_' + request.resource.data.mid
        && request.resource.data.by == request.auth.uid
        && request.resource.data.t == request.time;
      allow list, update, delete: if false;
    }
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
