rules_version = '2';
// Idle Heartwood playtest rules.
// - Each player's save lives at users/{uid}/... and only that signed-in player can read or write it.
// - The ladder is readable by anyone; a player can only write their own row, with sane values.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /ladder/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['r','best','w','l','d','n','f','t','name'])
        && request.resource.data.r is int && request.resource.data.r >= 100 && request.resource.data.r <= 4000
        && request.resource.data.best is int && request.resource.data.best <= 4000
        && request.resource.data.name is string && request.resource.data.name.size() <= 16;
    }
    match /{other=**} {
      allow read, write: if false;
    }
  }
}
